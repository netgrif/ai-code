# Optional. Copy to .env to use.
#
# The builder (http://localhost:4300) writes process files as the owner of ./processes.
# On Docker Desktop (Mac, Windows) the folder can look root-owned inside the container.
# Then set the user the builder should write as. Leave both unset on Linux.
#PUID=1000
#PGID=1000
#
# The realm the frontend (http://localhost:4200) should log users in to. The frontend 7.1.0
# does not read it: it signs in to the default realm, which the realm-init job sets to
# "app-users" (BYPASS W2, see workarounds/README.md). Kept for a frontend image that reads it.
#DEFAULT_REALM=app-users
#
# Memory limits of the Java services (the JVM heap is 70 % of the limit). The defaults suit a
# machine with 16 GB RAM; with the databases the whole cluster uses at most about 10 GB.
# Lower them only if the services still start and stay healthy; check with `podman stats` / `docker stats`
# and make sure no container is killed for lack of memory (State.OOMKilled).
#ADMIN_MEM_LIMIT=1500M
#ENGINE_MEM_LIMIT=2G
#SEARCH_MEM_LIMIT=1G
#GATEWAY_MEM_LIMIT=1G
#MCP_PLUGIN_MEM_LIMIT=1G
